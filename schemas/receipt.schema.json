{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "timestamp",
    "event_type",
    "payload",
    "previous_hash",
    "hash"
  ],
  "properties": {
    "timestamp": {
      "type": "string"
    },
    "event_type": {
      "type": "string"
    },
    "payload": {
      "type": "object"
    },
    "previous_hash": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64
    },
    "hash": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64
    }
  }
}